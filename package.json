{
  "name": "dansum",
  "version": "0.1.0",
  "private": true,
  "description": "AI 경제 뉴스 요약 플랫폼",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dansum/web dev",
    "dev:api": "pnpm --filter @dansum/api dev",
    "dev:collector": "pnpm --filter @dansum/collector dev",
    "dev:summarizer": "pnpm --filter @dansum/summarizer dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=20"
  }
}
