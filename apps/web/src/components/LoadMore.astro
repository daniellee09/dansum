---
interface Props {
	hasMore: boolean;
	/** 카테고리 페이지에서 필터를 유지하기 위한 slug. 홈에서는 비움 */
	category?: string;
	/** 매체 페이지에서 필터를 유지하기 위한 sources.id. 그 외에는 비움 */
	source?: string;
	/** 검색 페이지에서 검색어를 유지하기 위한 q. 그 외에는 비움 */
	query?: string;
	/** 정렬(최신순/인기순) 유지. 생략하면 정렬 파라미터를 보내지 않는다(검색은 관련도순 기본이 됨) */
	sort?: "latest" | "hot";
}

const { hasMore, category, source, query, sort } = Astro.props;
---

{hasMore && (
	<div class="pt-6 text-center">
		<button
			id="load-more"
			data-next-page="2"
			data-category={category ?? ""}
			data-source={source ?? ""}
			data-query={query ?? ""}
			data-sort={sort ?? ""}
			class="px-5 py-2 text-sm font-semibold text-text border border-border rounded-md bg-surface-alt hover:border-text-secondary transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
		>
			더 보기
		</button>
	</div>
)}

<script>
	import type { Article } from "@dansum/shared";
	import { renderArticleCard } from "../lib/renderArticleCard";
	import { setupBookmarkButtons } from "../lib/bookmarks";

	const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8787";

	// View Transitions 후 목록/버튼이 새로 그려지므로 매 page-load마다 재바인딩
	function setupLoadMore() {
		const btn = document.getElementById("load-more") as HTMLButtonElement | null;
		const list = document.getElementById("article-list");
		if (!(btn && list)) return;

		let page = Number(btn.dataset.nextPage ?? "2");
		const category = btn.dataset.category ?? "";
		const source = btn.dataset.source ?? "";
		const query = btn.dataset.query ?? "";
		const sort = btn.dataset.sort ?? "";

		btn.addEventListener("click", async () => {
			btn.disabled = true;
			btn.textContent = "불러오는 중…";
			try {
				const params = new URLSearchParams({ page: String(page) });
				if (category) params.set("category", category);
				if (source) params.set("source", source);
				if (query) params.set("q", query);
				if (sort) params.set("sort", sort);
				const res = await fetch(`${API_BASE}/api/articles?${params}`);
				const json = await res.json();
				const data = json.data as { items: Article[]; hasMore: boolean };

				for (const a of data.items) {
					const cardEl = renderArticleCard(a);
					list.appendChild(cardEl);
					setupBookmarkButtons(cardEl);
				}
				page++;

				if (data.hasMore) {
					btn.disabled = false;
					btn.textContent = "더 보기";
				} else {
					btn.remove();
				}
			} catch {
				btn.disabled = false;
				btn.textContent = "다시 시도";
			}
		});
	}

	document.addEventListener("astro:page-load", setupLoadMore);
</script>
