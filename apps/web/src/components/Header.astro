---
import type { AuthUser } from "@dansum/shared";
import { getInitialAvatar } from "../lib/userAvatar";

interface Props {
	user?: AuthUser | null;
}
const { user = null } = Astro.props;
const avatar = user ? getInitialAvatar(user.id, user.nickname) : null;

const logoLetters = "dansum".split("");
---

<!-- 전폭 고정 헤더: 사이드바보다 위(z-50)에 있고, 사이드바는 이 아래에서 시작한다 -->
<header id="app-header" class="fixed inset-x-0 top-0 z-50 border-b border-border bg-surface">
	<!-- 한 줄: [햄버거·로고] [검색창(가운데)] [테마]
	     lg+에서는 3열 그리드(양쪽 1fr)로 검색창을 정확히 가운데 두고,
	     그 아래에서는 flex로 남는 공간을 채운다(좁은 화면에서 그리드는 넘침). -->
	<div class="h-full px-4 sm:px-5">
		<div class="flex lg:grid lg:grid-cols-[1fr_minmax(0,30rem)_1fr] items-center gap-3 h-full">
			<div class="flex items-center gap-2 shrink-0 min-w-0">
				<!-- 좁은 화면에선 워드마크를 숨기고 검색창에 폭을 양보한다(레딧처럼) -->
				<a href="/" class="header-brand hidden sm:block shrink-0">
					<h1
						class="font-logo text-2xl font-semibold tracking-tighter text-text leading-none"
						aria-label="DANSUM"
					>
						{logoLetters.map((ch, idx) => (
							<span
								class="dansum-letter"
								style={`animation-delay:${idx * 55}ms`}
								aria-hidden="true"
							>
								{ch}
							</span>
						))}
					</h1>
				</a>

				<!-- 태그라인: 자리가 넉넉한 넓은 화면에서만 노출 -->
				<span class="header-brand hidden xl:block shrink-0 border-l border-border pl-3 text-xs text-text-secondary">
					<span class="font-bold text-text">단숨에</span> 보는 경제 이슈
				</span>
			</div>

			<!-- 검색창: 레딧식 알약, 가운데 정렬 -->
			<form action="/search" method="get" class="flex-1 min-w-0">
				<div class="flex items-center gap-2 lg:gap-2.5 w-full rounded-full border border-border bg-[color-mix(in_oklab,var(--color-text)_10%,var(--color-surface))] px-3.5 py-1.5 lg:px-4 lg:py-2 transition-colors hover:bg-[color-mix(in_oklab,var(--color-text)_15%,var(--color-surface))] focus-within:border-brand focus-within:bg-surface focus-within:ring-2 focus-within:ring-brand/40">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 lg:w-[18px] lg:h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<circle cx="11" cy="11" r="7" />
						<path stroke-linecap="round" d="M21 21l-4.3-4.3" />
					</svg>
					<input
						id="header-search"
						type="search"
						name="q"
						placeholder="단숨에 검색"
						autocomplete="off"
						aria-label="단숨에 검색"
						class="search-field peer w-full min-w-0 bg-transparent text-sm lg:text-[15px] outline-none placeholder:text-text-secondary"
					/>
					<kbd class="hidden sm:block shrink-0 rounded-full border border-border px-2 text-[11px] leading-5 text-text-secondary peer-focus:invisible">
						/
					</kbd>
				</div>
			</form>

			<!-- 유저·알림 -->
			<div class="flex justify-end items-center gap-1 shrink-0">
				<div class="relative">
					<button
						id="notif-bell-toggle"
						type="button"
						aria-label="알림"
						aria-haspopup="menu"
						aria-expanded="false"
						aria-controls="notif-menu"
						class:list={["relative w-9 h-9 shrink-0 flex items-center justify-center rounded-md text-text-secondary hover:text-text hover:bg-surface-alt transition-colors", !user && "hidden"]}
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M18 8a6 6 0 00-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.73 21a2 2 0 01-3.46 0" />
						</svg>
						<span
							id="notif-badge"
							class="hidden absolute top-1 right-1 min-w-[16px] h-4 px-1 rounded-full bg-hot text-white text-[10px] font-bold leading-4 text-center"
						>
							0
						</span>
					</button>

					<div
						id="notif-menu"
						role="menu"
						aria-hidden="true"
						aria-label="알림 메뉴"
						class="absolute right-0 top-[calc(100%+0.5rem)] z-50 w-72 origin-top-right rounded-lg bg-surface py-1.5 opacity-0 scale-95 pointer-events-none transition-[opacity,transform] duration-150 shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_16px_40px_-8px_rgba(0,0,0,0.35)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.08),0_16px_40px_-8px_rgba(0,0,0,0.6)]"
					>
						<div class="flex items-center justify-between px-3.5 py-2">
							<span class="text-sm font-semibold text-text">알림</span>
							<button id="notif-mark-all" type="button" class="text-xs text-text-secondary hover:text-brand transition-colors">
								모두 읽음
							</button>
						</div>
						<div class="my-1 border-t border-border"></div>
						<div id="notif-list" class="max-h-80 overflow-y-auto"></div>
					</div>
				</div>

				<div class="relative -mr-1.5">
					<button
						id="profile-menu-toggle"
						type="button"
						aria-label="내 정보"
						aria-haspopup="menu"
						aria-expanded="false"
						aria-controls="profile-menu"
						class="w-9 h-9 shrink-0 flex items-center justify-center rounded-md text-text-secondary hover:text-text hover:bg-surface-alt transition-colors"
					>
						{avatar ? (
							<span
								class="flex h-7 w-7 items-center justify-center rounded-full text-[13px] font-bold text-white"
								style={`background-color:${avatar.color}`}
								aria-hidden="true"
							>
								{avatar.initial}
							</span>
						) : (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
								<circle cx="12" cy="7" r="4" />
							</svg>
						)}
					</button>

					<!-- 계정 있으면 북마크/내 피드/다크모드/로그아웃, 없으면 로그인/회원가입만 실동작 -->
					<div
						id="profile-menu"
						role="menu"
						aria-hidden="true"
						aria-label="내 정보 메뉴"
						class="absolute right-0 top-[calc(100%+0.5rem)] z-50 w-56 origin-top-right rounded-lg bg-surface py-1.5 opacity-0 scale-95 pointer-events-none transition-[opacity,transform] duration-150 shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_16px_40px_-8px_rgba(0,0,0,0.35)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.08),0_16px_40px_-8px_rgba(0,0,0,0.6)]"
					>
						{user && (
							<div class="px-3.5 py-2 text-sm">
								<p class="font-semibold text-text truncate">{user.nickname}</p>
								<p class="text-[12px] text-text-secondary truncate">{user.email}</p>
							</div>
						)}
						{user && (
							<a
								href="/mypage"
								role="menuitem"
								class="flex items-center gap-3 px-3.5 py-2 text-sm text-text hover:bg-surface-alt transition-colors"
							>
								<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
									<circle cx="12" cy="7" r="4" />
								</svg>
								마이페이지
							</a>
						)}
						{user && <div class="my-1.5 border-t border-border"></div>}
						<a
							href="/bookmarks"
							role="menuitem"
							class="flex items-center gap-3 px-3.5 py-2 text-sm text-text hover:bg-surface-alt transition-colors"
						>
							<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 4h12v16l-6-4-6 4V4z" />
							</svg>
							북마크
						</a>
						<a
							href="/feed"
							role="menuitem"
							class="flex items-center gap-3 px-3.5 py-2 text-sm text-text hover:bg-surface-alt transition-colors"
						>
							<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M4 4a16 16 0 0116 16M4 4v5.5M4 11a9 9 0 019 9M4 18a2 2 0 102 2 2 2 0 00-2-2z" />
							</svg>
							내 피드
						</a>
						<button
							type="button"
							id="profile-menu-theme"
							role="menuitem"
							class="flex w-full items-center gap-3 px-3.5 py-2 text-sm text-text hover:bg-surface-alt transition-colors"
						>
							<svg id="profile-menu-theme-icon-moon" class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
							</svg>
							<svg id="profile-menu-theme-icon-sun" class="hidden w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="4" />
								<path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
							</svg>
							<span id="profile-menu-theme-label">다크 모드 전환</span>
						</button>

						<div class="my-1.5 border-t border-border"></div>

						{user ? (
							<button
								type="button"
								id="profile-menu-logout"
								role="menuitem"
								class="flex w-full items-center gap-3 px-3.5 py-2 text-sm text-text hover:bg-surface-alt transition-colors"
							>
								<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" />
								</svg>
								로그아웃
							</button>
						) : (
							<a
								href="/login"
								role="menuitem"
								class="flex items-center gap-3 px-3.5 py-2 text-sm text-text hover:bg-surface-alt transition-colors"
							>
								<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
									<circle cx="12" cy="7" r="4" />
								</svg>
								로그인 / 회원가입
							</a>
						)}
						<span
							role="menuitem"
							aria-disabled="true"
							class="flex cursor-not-allowed items-center gap-3 px-3.5 py-2 text-sm text-text-secondary opacity-60"
						>
							<svg class="w-[18px] h-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h13" />
								<circle cx="16" cy="6" r="2" />
								<circle cx="8" cy="12" r="2" />
								<circle cx="17" cy="18" r="2" />
							</svg>
							<span class="flex-1">설정</span>
							<span class="rounded-full border border-border px-2 py-0.5 text-[11px] font-semibold">준비 중</span>
						</span>
					</div>
				</div>

			</div>
		</div>
	</div>
</header>

<script>
	import { setupNotificationBell } from "../lib/notifications";

	// "/" 로 헤더 검색창 포커스(입력 중일 때는 무시). document 리스너라 1회 등록으로 충분.
	document.addEventListener("keydown", (e) => {
		if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
		const el = document.activeElement;
		const typing =
			el instanceof HTMLInputElement ||
			el instanceof HTMLTextAreaElement ||
			(el instanceof HTMLElement && el.isContentEditable);
		if (typing) return;
		const search = document.getElementById("header-search") as HTMLInputElement | null;
		if (!search) return;
		e.preventDefault();
		search.focus();
	});

	// 내 정보 드롭다운: 페이지 전환 시 헤더가 새로 그려지므로 매 page-load마다 재바인딩
	function setupProfileMenu() {
		const toggle = document.getElementById("profile-menu-toggle");
		const menu = document.getElementById("profile-menu");
		if (!(toggle && menu)) return;

		const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

		function setOpen(open: boolean) {
			toggle!.setAttribute("aria-expanded", String(open));
			menu!.setAttribute("aria-hidden", String(!open));
			menu!.classList.toggle("opacity-0", !open);
			menu!.classList.toggle("scale-95", !open);
			menu!.classList.toggle("pointer-events-none", !open);
			menu!.classList.toggle("opacity-100", open);
			menu!.classList.toggle("scale-100", open);
		}

		toggle.addEventListener("click", (e) => {
			e.stopPropagation();
			setOpen(!isOpen());
		});

		// 메뉴 바깥 클릭 시 닫기
		document.addEventListener("click", (e) => {
			if (isOpen() && !menu.contains(e.target as Node) && e.target !== toggle) setOpen(false);
		});

		// Esc로 닫고 트리거 버튼에 포커스 복귀
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && isOpen()) {
				setOpen(false);
				toggle.focus();
			}
		});

		// 실제 링크(북마크/내 피드) 클릭 시 메뉴 닫기.
		// 다크 모드 전환은 BaseLayout의 setupThemeToggle이 처리하며, 눌러도 메뉴는 안 닫는다.
		for (const link of menu.querySelectorAll("a")) {
			link.addEventListener("click", () => setOpen(false));
		}
	}

	async function setupLogout() {
		const btn = document.getElementById("profile-menu-logout");
		if (!btn || btn.dataset.bound) return;
		btn.dataset.bound = "true";
		btn.addEventListener("click", async () => {
			await fetch("/api/auth/logout", { method: "POST" }).catch(() => {});
			window.location.href = "/";
		});
	}

	document.addEventListener("astro:page-load", setupProfileMenu);
	document.addEventListener("astro:page-load", setupLogout);
	document.addEventListener("astro:page-load", setupNotificationBell);
	// 페이지 전환 시 이전 문서의 열림 상태가 남지 않게 정리
	document.addEventListener("astro:before-swap", () => {
		document.getElementById("profile-menu-toggle")?.setAttribute("aria-expanded", "false");
		document.getElementById("notif-bell-toggle")?.setAttribute("aria-expanded", "false");
	});
</script>
