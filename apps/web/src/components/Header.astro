---
import { CATEGORY_LABELS, CATEGORY_ORDER } from "@dansum/shared";

const categories = CATEGORY_ORDER;
const currentPath = Astro.url.pathname;
const logoLetters = "DANSUM".split("");
---

<header class="border-b border-border bg-surface/80 backdrop-blur-md sticky top-0 z-10">
	<div class="max-w-3xl mx-auto px-5">
		<div class="flex items-center justify-between py-5">
			<a href="/" class="group">
				<h1
					class="dansum-logo text-3xl font-extrabold tracking-tighter text-primary leading-none"
					aria-label="DANSUM"
				>
					{logoLetters.map((ch, idx) => (
						<span
							class="dansum-letter"
							style={`animation-delay:${idx * 55}ms`}
							aria-hidden="true"
						>
							{ch}
						</span>
					))}
				</h1>
				<p class="text-xs text-text-secondary mt-1.5">
					<span class="font-bold text-text">단숨에</span> 파악하는 경제 이슈
				</p>
			</a>
			<div class="flex items-center gap-1">
			<a
				href="/search"
				aria-label="검색"
				class="w-9 h-9 flex items-center justify-center rounded-md text-text-secondary hover:text-text hover:bg-surface-alt transition-colors"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<circle cx="11" cy="11" r="7" />
					<path stroke-linecap="round" d="M21 21l-4.3-4.3" />
				</svg>
			</a>
			<button
				id="theme-toggle"
				aria-label="다크 모드 전환"
				class="w-9 h-9 flex items-center justify-center rounded-md text-text-secondary hover:text-text hover:bg-surface-alt transition-colors"
			>
				<svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
				</svg>
				<svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="5" />
					<path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
				</svg>
			</button>
			</div>
		</div>
		<!-- 트랙 없는 알약 탭: active만 소프트블루 알약(떠 있는 느낌), 나머지는 텍스트+호버 알약 -->
		<nav class="flex gap-1 pt-1.5 pb-3 -mx-1.5 px-1.5 overflow-x-auto scrollbar-hide">
			<a
				href="/"
				class:list={[
					"px-3.5 py-1.5 text-sm font-medium rounded-full whitespace-nowrap transition-colors",
					currentPath === "/"
						? "nav-glass text-text"
						: "border border-transparent text-text-secondary hover:text-text hover:bg-surface-alt",
				]}
			>
				전체
			</a>
			{categories.map((cat) => (
				<a
					href={`/category/${cat}`}
					class:list={[
						"px-3.5 py-1.5 text-sm font-medium rounded-full whitespace-nowrap transition-colors",
						currentPath === `/category/${cat}`
							? "nav-glass text-text"
							: "border border-transparent text-text-secondary hover:text-text hover:bg-surface-alt",
					]}
				>
					{CATEGORY_LABELS[cat]}
				</a>
			))}
		</nav>
	</div>
</header>
