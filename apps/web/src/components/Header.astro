---
const logoLetters = "DANSUM".split("");
---

<!-- 전폭 고정 헤더: 사이드바보다 위(z-50)에 있고, 사이드바는 이 아래에서 시작한다 -->
<header id="app-header" class="fixed inset-x-0 top-0 z-50 border-b border-border bg-surface">
	<!-- 한 줄: [햄버거·로고] [검색창(가운데)] [테마]
	     lg+에서는 3열 그리드(양쪽 1fr)로 검색창을 정확히 가운데 두고,
	     그 아래에서는 flex로 남는 공간을 채운다(좁은 화면에서 그리드는 넘침). -->
	<div class="h-full px-4 sm:px-5">
		<div class="flex lg:grid lg:grid-cols-[1fr_minmax(0,40rem)_1fr] items-center gap-3 h-full">
			<div class="flex items-center gap-2 shrink-0 min-w-0">
				<button
					id="sidebar-toggle"
					type="button"
					aria-label="메뉴 열기"
					aria-expanded="false"
					aria-controls="app-sidebar"
					class="w-9 h-9 -ml-1.5 shrink-0 flex items-center justify-center rounded-md text-text-secondary hover:text-text hover:bg-surface-alt transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>

				<a href="/" class="header-brand shrink-0">
					<h1
						class="text-2xl font-extrabold tracking-tight text-text leading-none"
						aria-label="DANSUM"
					>
						{logoLetters.map((ch, idx) => (
							<span
								class="dansum-letter"
								style={`animation-delay:${idx * 55}ms`}
								aria-hidden="true"
							>
								{ch}
							</span>
						))}
					</h1>
				</a>

				<!-- 태그라인: 자리가 넉넉한 넓은 화면에서만 노출 -->
				<span class="header-brand hidden xl:block shrink-0 border-l border-border pl-3 text-xs text-text-secondary">
					<span class="font-bold text-text">단숨에</span> 파악하는 경제 이슈
				</span>
			</div>

			<!-- 검색창: 레딧식 알약, 가운데 정렬 -->
			<form action="/search" method="get" class="flex-1 min-w-0">
				<div class="flex items-center gap-2.5 w-full rounded-full border border-border bg-surface-alt px-5 py-2.5 transition-colors focus-within:border-brand focus-within:bg-surface focus-within:ring-2 focus-within:ring-brand/40">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<circle cx="11" cy="11" r="7" />
						<path stroke-linecap="round" d="M21 21l-4.3-4.3" />
					</svg>
					<input
						id="header-search"
						type="search"
						name="q"
						placeholder="단숨에 검색"
						autocomplete="off"
						aria-label="단숨에 검색"
						class="search-field peer w-full min-w-0 bg-transparent text-[15px] outline-none placeholder:text-text-secondary"
					/>
					<kbd class="hidden sm:block shrink-0 rounded-full border border-border px-2 text-[11px] leading-5 text-text-secondary peer-focus:invisible">
						/
					</kbd>
				</div>
			</form>

			<div class="flex justify-end shrink-0">
				<button
					id="theme-toggle"
					aria-label="다크 모드 전환"
					class="w-9 h-9 -mr-1.5 shrink-0 flex items-center justify-center rounded-md text-text-secondary hover:text-text hover:bg-surface-alt transition-colors"
				>
					<svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
					</svg>
					<svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="5" />
						<path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
					</svg>
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	// "/" 로 헤더 검색창 포커스(입력 중일 때는 무시). document 리스너라 1회 등록으로 충분.
	document.addEventListener("keydown", (e) => {
		if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
		const el = document.activeElement;
		const typing =
			el instanceof HTMLInputElement ||
			el instanceof HTMLTextAreaElement ||
			(el instanceof HTMLElement && el.isContentEditable);
		if (typing) return;
		const search = document.getElementById("header-search") as HTMLInputElement | null;
		if (!search) return;
		e.preventDefault();
		search.focus();
	});
</script>
