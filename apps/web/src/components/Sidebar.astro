---
import { CATEGORY_LABELS, CATEGORY_ORDER } from "@dansum/shared";

const currentPath = Astro.url.pathname;

/** 카테고리 아이콘: 24×24 viewBox, 선 아이콘(fill 없음)으로 다른 메뉴 아이콘과 톤을 맞춘다.
    작은 크기(18px)에서 뭉개지지 않도록 획 수를 최소로 유지했다. */
const CATEGORY_ICONS: Record<string, string> = {
	// 금융: 지폐
	finance: `<rect x="2.5" y="6" width="19" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /><path stroke-linecap="round" d="M6 9.5v5M18 9.5v5" />`,
	// 증시: 우상향 꺾은선
	market: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5l5-5 3.5 3.5L20.5 6M15 6h5.5v5.5" />`,
	// 산업·기업: 제품 상자(3D 큐브)
	industry: `<path stroke-linejoin="round" d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M4.3 7.6L12 12l7.7-4.4M12 12v9" />`,
	// 부동산: 창이 있는 건물
	realestate: `<path stroke-linejoin="round" d="M4.5 21V4h8.5v17M13 12h6.5v9" /><path stroke-linecap="round" d="M3 21h18M7.5 8.5h2.5M7.5 13h2.5M15.8 16h1.4" />`,
	// 무역·통상: 지구본
	trade: `<circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path stroke-linecap="round" d="M3.2 12h17.6" />`,
	// 거시·정책: 기둥이 있는 관공서
	macro: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.5 10L12 5l8.5 5" /><path stroke-linecap="round" d="M6 10.5v8M10 10.5v8M14 10.5v8M18 10.5v8M3 21h18" />`,
};

/** href가 있으면 실제 링크, 없으면 아직 라우트가 없는 항목이라 disabled + "준비 중" 배지 */
// 랭킹은 기획이 아직 안 끝나 메뉴에서 뺐다(ranking.astro 자체도 "/"로 리다이렉트되게 막아둠).
const communityItems = [
	{ label: "내 피드", icon: "feed", href: "/feed" },
	{ label: "북마크", icon: "bookmark", href: "/bookmarks" },
	{ label: "토론", icon: "chat" },
	{ label: "키워드 알림", icon: "bell" },
];
---

<!-- 배경 딤: 열렸을 때만 보이고 클릭하면 닫힌다 -->
<div
	id="sidebar-overlay"
	class="fixed inset-x-0 bottom-0 z-30 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-200"
	aria-hidden="true"
>
</div>

<!-- 사이드바 접기/펼치기: 헤더 대신 사이드바-본문 경계선에 붙는 세로 탭(VS Code·GitHub 스타일).
     원형 버튼과 달리 경계선에 걸치지 않고 완전히 본문 쪽(펼침) 또는 화면 왼쪽 끝(접힘)에 살짝
     붙어 있다가, 화살표 하나(‹)가 상태에 따라 180도 돌아 반대 방향(›)을 가리킨다.
     left 값은 global.css에서 사이드바 상태(모바일 열림/닫힘, 데스크톱 접힘)에 따라 옮긴다. -->
<button
	id="sidebar-toggle"
	type="button"
	aria-label="메뉴 열기"
	aria-expanded="false"
	aria-controls="app-sidebar"
	class="sidebar-edge-toggle fixed z-50 flex h-11 w-4 items-center justify-center rounded-r-md border border-l-0 border-border bg-surface text-text-secondary opacity-70 transition-[left,opacity] duration-200 ease-out hover:opacity-100 hover:bg-surface-alt hover:text-text"
>
	<svg
		id="sidebar-toggle-icon"
		xmlns="http://www.w3.org/2000/svg"
		class="h-3.5 w-3.5 shrink-0 transition-transform duration-200"
		fill="none"
		viewBox="0 0 24 24"
		stroke="currentColor"
		stroke-width="2.5"
	>
		<path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6" />
	</svg>
</button>

<aside
	id="app-sidebar"
	class="fixed bottom-0 left-0 z-40 flex max-w-[85vw] flex-col border-r border-border bg-surface transition-transform duration-200 ease-out"
	aria-label="사이트 메뉴"
>
	<!-- 닫기: 모바일 오버레이일 때만 필요(데스크톱은 헤더의 햄버거로 접는다) -->
	<div class="lg:hidden flex justify-end px-3 pt-3">
		<button
			id="sidebar-close"
			type="button"
			aria-label="메뉴 닫기"
			class="w-9 h-9 flex items-center justify-center rounded-md text-text-secondary hover:text-text hover:bg-surface-alt transition-colors"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
	</div>

	<nav class="flex-1 overflow-y-auto px-3 py-3">
		<!-- 둘러보기 -->
		<ul class="space-y-0.5">
			<li>
				<a
					href="/"
					class:list={[
						"flex items-center gap-3 rounded-md px-3 py-2 text-[15px] transition-colors hover:bg-surface-alt",
						currentPath === "/" ? "font-semibold text-text bg-surface-alt" : "text-text",
					]}
				>
					<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 10.5 12 4l8 6.5" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 9v10a.5.5 0 00.5.5H10v-5.5h4V19.5h3.5a.5.5 0 00.5-.5V9" />
					</svg>
					홈
				</a>
			</li>
			<li>
				<a
					href="/hot"
					class:list={[
						"flex items-center gap-3 rounded-md px-3 py-2 text-[15px] transition-colors hover:bg-surface-alt",
						currentPath === "/hot" ? "font-semibold text-text bg-surface-alt" : "text-text",
					]}
				>
					<!-- Hot 아이콘은 --color-hot 토큰(급상승/NEW 배지와 동일한 의미)을 그대로 쓴다.
					     hot.astro 제목 옆 아이콘과 모양을 맞춰야 하니 수정 시 함께 동기화할 것. -->
					<svg class="w-[18px] h-[18px] shrink-0 fill-hot" viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill-rule="evenodd"
							clip-rule="evenodd"
							d="M12.5 1.5c1 3.2-1.8 5-3 7.5-.7-.9-1-2.2-1-3.3-2 2-3.5 5-3.5 8 0 4.6 3.5 8.3 8 8.3s8-3.7 8-8.3c0-3-1.6-5.6-3.7-7.4.1 1.3-.2 2.6-1 3.6-.4-3.3-2.3-5.6-3.8-8.4zm-.5 11c1 1.7 2.5 2.7 2.5 4.8 0 1.8-1.3 3.2-3 3.2s-3-1.4-3-3.2c0-1.1.4-1.9 1-2.7.4.5 1 .9 1 .9-.2-1.2.4-2 1.5-3z"
						/>
					</svg>
					Hot
				</a>
			</li>
			<li>
				<a
					href="/#latest"
					class="flex items-center gap-3 rounded-md px-3 py-2 text-[15px] text-text transition-colors hover:bg-surface-alt"
				>
					<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
						<circle cx="12" cy="12" r="8.5" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5V12l3 2" />
					</svg>
					최신 뉴스
				</a>
			</li>
			<li>
				<a
					href="/search"
					class:list={[
						"flex items-center gap-3 rounded-md px-3 py-2 text-[15px] transition-colors hover:bg-surface-alt",
						currentPath === "/search" ? "font-semibold text-text bg-surface-alt" : "text-text",
					]}
				>
					<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
						<circle cx="11" cy="11" r="7" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3" />
					</svg>
					검색
				</a>
			</li>
		</ul>

		<hr class="my-3 border-border" />

		<!-- 커뮤니티: href가 있는 항목은 실제 라우트, 없는 항목은 아직 "준비 중" -->
		<ul class="space-y-0.5">
			{communityItems.map((item) => (
				<li>
					{item.href ? (
						<a
							href={item.href}
							class:list={[
								"flex items-center gap-3 rounded-md px-3 py-2 text-[15px] transition-colors hover:bg-surface-alt",
								currentPath === item.href ? "font-semibold text-text bg-surface-alt" : "text-text",
							]}
						>
							<svg class="w-[18px] h-[18px] shrink-0 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
								{item.icon === "feed" && (
									<path stroke-linecap="round" stroke-linejoin="round" d="M4 4a16 16 0 0116 16M4 4v5.5M4 11a9 9 0 019 9M4 18a2 2 0 102 2 2 2 0 00-2-2z" />
								)}
								{item.icon === "bookmark" && (
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 4h12v16l-6-4-6 4V4z" />
								)}
								{item.icon === "ranking" && (
									<path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8M12 17v4M7 4h10v4a5 5 0 01-10 0V4zM7 6H4v1a4 4 0 003 3.87M17 6h3v1a4 4 0 01-3 3.87" />
								)}
							</svg>
							<span class="flex-1">{item.label}</span>
						</a>
					) : (
						<span
							class="flex cursor-not-allowed items-center gap-3 rounded-md px-3 py-2 text-[15px] text-text-secondary opacity-60"
							aria-disabled="true"
						>
							<svg class="w-[18px] h-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
								{item.icon === "chat" && (
									<path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.4 8.4 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.4 8.4 0 01-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.4 8.4 0 013.8-.9h.5a8.5 8.5 0 018 8v.5z" />
								)}
								{item.icon === "bell" && (
									<path stroke-linecap="round" stroke-linejoin="round" d="M18 8a6 6 0 10-12 0c0 6-2 7-2 7h16s-2-1-2-7M10.5 20a2 2 0 003 0" />
								)}
							</svg>
							<span class="flex-1">{item.label}</span>
							<span class="rounded-full border border-border px-2 py-0.5 text-[11px] font-semibold">
								준비 중
							</span>
						</span>
					)}
				</li>
			))}
		</ul>

		<hr class="my-3 border-border" />

		<!-- 카테고리 -->
		<h2 class="px-3 pb-1.5 text-[13px] font-semibold text-text-secondary">카테고리</h2>
		<ul class="space-y-0.5">
			{CATEGORY_ORDER.map((cat) => (
				<li>
					<a
						href={`/category/${cat}`}
						class:list={[
							"flex items-center gap-3 rounded-md px-3 py-2 text-[15px] transition-colors hover:bg-surface-alt",
							currentPath === `/category/${cat}` ? "font-semibold text-text bg-surface-alt" : "text-text",
						]}
					>
						<svg
							class="w-[18px] h-[18px] shrink-0 text-text-secondary"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="1.75"
							aria-hidden="true"
							set:html={CATEGORY_ICONS[cat] ?? ""}
						/>
						{CATEGORY_LABELS[cat]}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<!-- 하단 브랜드 표기: 레딧처럼 구분선·배경 없이 미세한 저작권 한 줄만 둔다 -->
	<div class="px-6 pt-3 pb-4">
		<p class="text-[12px] leading-relaxed text-text-secondary">
			DANSUM &copy; {new Date().getFullYear()}. All rights reserved.
		</p>
	</div>
</aside>

<script>
	// 데스크톱은 도킹(접기/펼치기, localStorage에 유지), 모바일은 오버레이 드로어.
	// View Transitions로 사이드바/토글이 새로 그려지므로 매 page-load마다 재바인딩.
	function setupSidebar() {
		const sidebar = document.getElementById("app-sidebar");
		const overlay = document.getElementById("sidebar-overlay");
		const toggle = document.getElementById("sidebar-toggle");
		const closeBtn = document.getElementById("sidebar-close");
		if (!(sidebar && overlay && toggle)) return;

		const html = document.documentElement;
		const isDesktop = () => window.matchMedia("(min-width: 1024px)").matches;
		const isVisible = () =>
			isDesktop()
				? !html.classList.contains("sidebar-collapsed")
				: html.classList.contains("sidebar-open");

		function sync() {
			const visible = isVisible();
			toggle!.setAttribute("aria-expanded", String(visible));
			toggle!.setAttribute("aria-label", visible ? "메뉴 접기" : "메뉴 열기");
			// 화살표 하나(‹)를 펼침일 땐 그대로, 접힘일 땐 180도 돌려 반대 방향(›)을 가리키게 한다
			document
				.getElementById("sidebar-toggle-icon")
				?.classList.toggle("rotate-180", !visible);
			// 접혀 있으면 화면 밖이라 보조기기·탭 이동에서 제외
			sidebar!.setAttribute("aria-hidden", visible ? "false" : "true");
			sidebar!.inert = !visible;
			// 배경 스크롤 잠금은 화면을 덮는 모바일 오버레이일 때만
			document.body.style.overflow = !isDesktop() && visible ? "hidden" : "";
		}

		function toggleSidebar() {
			if (isDesktop()) {
				const collapsed = html.classList.toggle("sidebar-collapsed");
				localStorage.setItem("sidebar", collapsed ? "collapsed" : "docked");
			} else {
				html.classList.toggle("sidebar-open");
			}
			sync();
		}

		function hide() {
			if (isDesktop()) {
				html.classList.add("sidebar-collapsed");
				localStorage.setItem("sidebar", "collapsed");
			} else {
				html.classList.remove("sidebar-open");
			}
			sync();
		}

		toggle.addEventListener("click", toggleSidebar);
		closeBtn?.addEventListener("click", hide);
		overlay.addEventListener("click", hide);
		// 모바일에서만: 링크를 누르면 화면을 덮은 드로어를 닫는다(데스크톱은 고정 유지)
		for (const link of sidebar.querySelectorAll("a")) {
			link.addEventListener("click", () => {
				if (!isDesktop()) hide();
			});
		}
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !isDesktop() && html.classList.contains("sidebar-open")) {
				hide();
				toggle.focus();
			}
		});
		// 폭이 바뀌면 도킹/오버레이 기준이 달라지므로 상태를 다시 맞춘다
		window.addEventListener("resize", sync);

		sync();
	}

	document.addEventListener("astro:page-load", setupSidebar);
	// 페이지 전환 시 모바일 오버레이 상태와 스크롤 잠금이 남지 않도록 해제
	document.addEventListener("astro:after-swap", () => {
		document.documentElement.classList.remove("sidebar-open");
		document.body.style.overflow = "";
	});
</script>
