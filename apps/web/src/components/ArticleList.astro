---
import type { Article } from "@dansum/shared";
import ArticleCard from "./ArticleCard.astro";

interface Props {
	articles: Article[];
}

const { articles } = Astro.props;
---

{articles.length > 0 ? (
	<!-- -mx-4 px-4: 자식(ArticleCard)의 호버 확장 폭과 구분선 폭을 맞추기 위해 같이 넓힌다 -->
	<div id="article-list" class="-mx-4 px-4 divide-y divide-border border-t border-border">
		{articles.map((article) => (
			<ArticleCard article={article} />
		))}
	</div>
) : (
	<div class="py-20 text-center">
		<p class="text-lg text-text-secondary">아직 뉴스가 없습니다</p>
		<p class="text-sm text-text-secondary mt-1">곧 새로운 소식이 업데이트됩니다</p>
	</div>
)}
