---
import { CATEGORY_LABELS, formatRelativeTime } from "@dansum/shared";
import type { Article, Category } from "@dansum/shared";
import SourceIcon from "./SourceIcon.astro";

interface Props {
	article: Article;
}

const { article } = Astro.props;
---

<!-- 주의: lib/renderArticleCard.ts의 renderArticleCard()와 마크업 중복 — 한쪽 수정 시 반드시 동기화
     (LoadMore·북마크·내 피드 페이지는 클라이언트에서 그 함수로 이 마크업을 그대로 재현한다) -->
<!-- 기사 사이는 목록의 구분선(divide-y)이 나누고, 칸 안쪽은 요약 패널까지 갖춘 구성.
     -mx-4 px-4: 호버 배경을 본문보다 좌우로 넓혀 "행 전체"가 선택된 느낌을 준다.
     (ArticleList도 같은 값으로 확장해야 구분선과 폭이 맞는다) -->
<article class="group -mx-4 px-4 py-5 transition-colors hover:bg-surface-alt">
	<!-- 헤더: 아이콘 + 매체명·카테고리 / 시간. 향후 "댓글 N"은 이 줄 끝에 append -->
	<div class="flex items-start gap-x-2.5">
		<!-- 아바타도 매체 목록으로 이동. 이름 링크와 중복 탭 정지가 되지 않게 포커스 대상에서 뺀다 -->
		<a href={`/source/${article.sourceId}`} tabindex="-1" aria-hidden="true" class="shrink-0">
			<SourceIcon
				sourceId={article.sourceId}
				sourceUrl={article.sourceUrl}
				sourceName={article.sourceName}
				size={26}
			/>
		</a>
		<div class="min-w-0 flex-1 text-sm leading-tight">
			<div class="flex items-center gap-x-2">
				<a
					href={`/source/${article.sourceId}`}
					class="font-semibold text-text hover:text-brand hover:underline"
				>
					{article.sourceName}
				</a>
				<a
					href={`/category/${article.category}`}
					class="text-text-secondary hover:text-brand hover:underline"
				>
					{CATEGORY_LABELS[article.category as Category] ?? article.category}
				</a>
			</div>
			<time class="mt-1 block text-[13px] text-text-secondary tabular-nums">
				{formatRelativeTime(article.publishedAt)}
			</time>
		</div>

		<button
			type="button"
			data-bookmark-toggle
			data-article-id={article.id}
			aria-label="북마크"
			aria-pressed="false"
			class="bookmark-btn shrink-0 -mr-1.5 -mt-1 w-8 h-8 flex items-center justify-center rounded-md text-text-secondary hover:text-text hover:bg-surface-alt transition-colors"
		>
			<svg data-bookmark-icon class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 4h12v16l-6-4-6 4V4z" />
			</svg>
		</button>
	</div>

	<a href={`/article/${article.id}`} class="block read-link mt-3.5">
		<h2 class="text-xl font-semibold leading-snug group-hover:text-brand transition-colors">
			{article.title}
		</h2>
		<!-- 요약: 칸 안쪽 중첩 패널. 행이 호버되면 배경이 같아져 묻히므로 반대로 뒤집는다 -->
		<div class="mt-3 rounded-md bg-surface-alt group-hover:bg-surface transition-colors px-4 py-3.5">
			<p class="text-[15px] text-text-secondary leading-relaxed line-clamp-2">
				{article.summary}
			</p>
			<span class="mt-2 inline-block text-sm font-semibold text-text underline">
				더 보기
			</span>
		</div>
	</a>
</article>
