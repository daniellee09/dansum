---
import { CATEGORY_LABELS, formatRelativeTime } from "@dansum/shared";
import type { Category, NewsCluster } from "@dansum/shared";
import SourceIcon from "./SourceIcon.astro";

interface Props {
	clusters: NewsCluster[];
}

const { clusters } = Astro.props;
---

{clusters.length > 0 && (
	<section class="mb-6 rounded-lg border border-border bg-surface px-5 py-4">
		<!-- 섹션 헤더 -->
		<div class="mb-2">
			<h2 class="text-lg font-bold tracking-tight">오늘의 주요 뉴스</h2>
			<p class="text-[13px] text-text-secondary mt-1">여러 매체가 함께 보도한 이슈</p>
		</div>

		<!-- -mx-3 px-3: 자식 li의 호버 확장 폭과 구분선 폭을 맞춘다 -->
		<ol class="-mx-3 px-3 divide-y divide-border">
			{clusters.map((cluster, i) => {
				const a = cluster.lead;
				const rc = cluster.rankChange;
				const isNew = rc === null;
				const isUp = rc !== null && rc > 0;
				const isDown = rc !== null && rc < 0;

				return (
					<li class="group relative -mx-3 px-3 py-3.5 transition-colors hover:bg-surface-alt">
						<!-- 카드 전체가 기사 링크(제목 링크의 stretch-link). 매체·카테고리는 그 위에서 따로 눌린다 -->
						<div class="flex gap-4 items-start">

							<!-- 순위 번호 + 변동 표시 -->
							<div class="flex flex-col items-center w-7 shrink-0 pt-0.5 gap-0.5">
								<span class="text-lg font-bold font-mono text-text-secondary tabular-nums leading-none">
									{i + 1}
								</span>
								{isNew && (
									<span class="text-[11px] font-bold text-hot leading-none tracking-tight">
										NEW
									</span>
								)}
								{isUp && (
									<span class="text-[11px] font-bold text-hot leading-none">
										▲{rc}
									</span>
								)}
								{isDown && (
									<span class="text-[11px] font-bold text-text-secondary leading-none">
										▼{Math.abs(rc as number)}
									</span>
								)}
								{rc === 0 && (
									<span class="text-[11px] text-text-secondary leading-none">
										-
									</span>
								)}
							</div>

							<!-- 기사 내용 -->
							<div class="min-w-0 flex-1">
								<!-- 출처 라인(레딧식): 아이콘 + 매체명 · 카테고리 · 시간 -->
								<!-- 좁은 화면에서 각 항목이 글자 단위로 쪼개지지 않도록 항목별 nowrap + 줄바꿈 허용 -->
								<div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[13px] text-text-secondary">
									<a
										href={`/source/${a.sourceId}`}
										tabindex="-1"
										aria-hidden="true"
										class="stretch-over shrink-0"
									>
										<SourceIcon
											sourceId={a.sourceId}
											sourceUrl={a.sourceUrl}
											sourceName={a.sourceName}
											size={22}
										/>
									</a>
									<a
										href={`/source/${a.sourceId}`}
										class="stretch-over font-bold text-text whitespace-nowrap hover:text-brand hover:underline"
									>
										{a.sourceName}
									</a>
									<span aria-hidden="true">·</span>
									<a
										href={`/category/${a.category}`}
										class="stretch-over font-medium text-accent whitespace-nowrap hover:text-brand hover:underline"
									>
										{CATEGORY_LABELS[a.category as Category] ?? a.category}
									</a>
									<span aria-hidden="true">·</span>
									<time class="tabular-nums whitespace-nowrap">{formatRelativeTime(a.publishedAt)}</time>
									{cluster.coverage > 1 && (
										<>
											<span aria-hidden="true">·</span>
											<span class="tabular-nums whitespace-nowrap">{cluster.coverage}개 매체</span>
										</>
									)}
								</div>

								<a href={`/article/${a.id}`} class="read-link stretch-link block">
									<h3 class="text-lg font-semibold leading-snug mt-1.5 group-hover:text-brand transition-colors">
										{a.title}
									</h3>

									<p class="text-[15px] text-text-secondary mt-1 line-clamp-2">
										{a.summary}
									</p>

									<!-- 대표 이미지: 기사 아래에 크게. 원본이 500~660px대라 폭을 꽉 채우면
									     확대돼 뭉개진다 → 원본 크기(최대 컬럼 폭·높이 340px)로만 두고 프레임 안에서 가운데 정렬.
									     없거나 로드 실패하면 프레임째 사라진다(onerror). -->
									{a.imageUrl && (
										<div class="mt-3 overflow-hidden rounded-md border border-border bg-surface-alt">
											<img
												src={a.imageUrl}
												alt=""
												loading="lazy"
												decoding="async"
												referrerpolicy="no-referrer"
												class="mx-auto block max-h-[340px] max-w-full object-contain"
												onerror="this.closest('div').remove()"
											/>
										</div>
									)}
								</a>
							</div>
						</div>
					</li>
				);
			})}
		</ol>
	</section>
)}
