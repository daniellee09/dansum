---
import type { SuggestedTopic } from "../lib/server/discussions";

interface Props {
	topics: SuggestedTopic[];
	/** 기사 상세처럼 좁은 자리에서는 제목 줄을 줄인다 */
	compact?: boolean;
}
const { topics, compact = false } = Astro.props;
---

{/* "가장 많이 보도된 주제"를 토론거리로 권한다. 이미 토론이 열린 이슈는 제외되므로
    (suggestTopics 참고) 같은 이야기가 두 곳으로 갈리지 않는다. */}
{topics.length > 0 && (
	<div class:list={["rounded-lg border border-border bg-surface-alt px-4 py-3.5", compact ? "" : "mb-6"]}>
		<p class="text-[13px] font-semibold text-text">
			{compact ? "이 주제로 이야기해볼까요?" : "오늘 이런 주제는 어떠세요"}
		</p>
		<ul class="mt-2 space-y-2.5">
			{topics.map((t) => (
				<li>
					<a
						href={`/discuss/new?issue=${t.issueId}`}
						class="group block"
					>
						<span class="text-sm leading-snug text-text group-hover:text-brand transition-colors">
							{t.title}
						</span>
						<span class="mt-0.5 block text-xs text-text-secondary tabular-nums">
							{t.coverage}개 매체 · {t.sourceNames.slice(0, 3).join(", ")}
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
)}
