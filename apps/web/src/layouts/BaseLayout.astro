---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
	title?: string;
	description?: string;
	/** 공유 카드 타입: 홈/목록은 website, 기사 상세는 article */
	type?: "website" | "article";
	/** 본문 옆에 사이드바를 둘 만큼 넓은 칼럼이 필요한 페이지용. true면 기사 상세 폭(70.5rem),
	    문자열이면 그 값을 총 폭으로 쓴다(예: 홈의 74rem). --content-w도 같이 늘려야 헤더
	    검색창과의 세로 중심선이 맞는다(global.css 참고). */
	wide?: boolean | string;
}

const {
	title = "단숨 - AI 경제 뉴스 요약",
	description = "세계 주요 경제 뉴스를 단숨에 파악하세요. AI가 핵심만 요약해드립니다.",
	type = "website",
	wide = false,
} = Astro.props;

// 기사 상세(46rem 본문+20rem 사이드바+2rem gap+2.5rem ml-10=70.5rem)와 홈(52rem 본문+20rem
// 사이드바+2rem gap=74rem)처럼 wide 페이지마다 필요한 폭이 달라 값 하나로 일반화한다.
const wideWidth = wide === true ? "70.5rem" : wide || null;

const canonical = new URL(Astro.url.pathname, Astro.url).href;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />

		<!-- Open Graph (카카오톡·페북 등 공유 미리보기) -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="단숨" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- Pretendard 폰트 -->
		<link
			rel="stylesheet"
			as="style"
			crossorigin
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- 페이지 전환 애니메이션(SPA식 부드러운 전환) -->
		<ClientRouter />

		<!-- 다크 모드·사이드바 깜빡임 방지: 최초 렌더 전 + 페이지 전환(swap) 직후에 클래스 재적용 -->
		<script is:inline>
			function applyTheme() {
				const stored = localStorage.getItem("theme");
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle(
					"dark",
					stored === "dark" || (!stored && prefersDark),
				);
			}
			// 데스크톱 사이드바는 기본 고정. 사용자가 접었을 때만 클래스를 붙인다.
			function applySidebar() {
				document.documentElement.classList.toggle(
					"sidebar-collapsed",
					localStorage.getItem("sidebar") === "collapsed",
				);
			}
			applyTheme();
			applySidebar();
			// View Transitions swap 시 들어오는 SSR 문서엔 상태 클래스가 없어 깜빡일 수 있어 재적용
			document.addEventListener("astro:after-swap", () => {
				applyTheme();
				applySidebar();
			});
		</script>
	</head>
	<body class="min-h-screen pt-[var(--header-h)]">
		<!-- 헤더는 전폭이라 app-shell(사이드바 폭만큼 밀림) 바깥에 둔다 -->
		<Header />
		<Sidebar />
		<!-- app-shell: 데스크톱에서 고정된 사이드바 폭만큼 밀린다(global.css) -->
		<div
			class:list={["app-shell flex flex-col transition-[padding] duration-200 ease-out", wideWidth && "app-shell--wide"]}
			style={wideWidth ? `--wide-w: ${wideWidth}` : undefined}
		>
			<main
				class:list={[
					"flex-1 w-full mx-auto px-5 py-7 max-w-[52rem]",
					wideWidth && "app-shell--wide-main",
				]}
			>
				<slot />
			</main>
			<Footer />
		</div>

		<!-- wide 페이지(기사 상세 70.5rem, 홈 74rem 등): <main>이 헤더 검색창과 가운데 정렬되면
		     본문+사이드바 덩어리도 그대로 가운데 정렬된다. --content-w와 <main>의 max-w가 항상
		     같은 --wide-w 값을 쓰도록 묶어야 세로 중심선이 어긋나지 않는다(article/[id].astro,
		     index.astro 참고). -->
		<style>
			@media (min-width: 87.5rem) {
				.app-shell--wide {
					--content-w: var(--wide-w);
				}
				.app-shell--wide-main {
					max-width: var(--wide-w);
				}
			}
		</style>

		<!-- 맨 위로: 일정 스크롤 후 우하단에 부드럽게 등장 -->
		<button
			id="to-top"
			type="button"
			aria-label="맨 위로"
			class="fixed bottom-6 right-6 z-20 flex h-10 w-10 items-center justify-center rounded-md border border-border bg-surface text-text-secondary transition-all duration-200 hover:text-text hover:bg-surface-alt opacity-0 translate-y-2 pointer-events-none"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7" />
			</svg>
		</button>

		<script>
			// 맨 위로 버튼: window 스크롤 리스너는 1회만 등록(window는 전환 간 유지),
			// 버튼 참조/클릭 바인딩은 매 page-load마다 갱신(View Transitions로 버튼이 새로 그려짐)
			let toTopBtn: HTMLElement | null = null;
			const HIDDEN = ["opacity-0", "translate-y-2", "pointer-events-none"];
			function updateToTop() {
				if (!toTopBtn) return;
				const show = window.scrollY > 400;
				for (const c of HIDDEN) toTopBtn.classList.toggle(c, !show);
			}
			window.addEventListener("scroll", updateToTop, { passive: true });
			document.addEventListener("astro:page-load", () => {
				toTopBtn = document.getElementById("to-top");
				toTopBtn?.addEventListener("click", () => {
					const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
				});
				updateToTop();
			});
		</script>

		<script>
			// 페이지 전환(View Transitions) 후 헤더가 새로 그려지므로 매 page-load마다 재바인딩.
			// 토글은 프로필 드롭다운(Header.astro) 안의 "다크 모드 전환" 항목 하나뿐이라
			// 별도 아이콘 상태 동기화는 필요 없다.
			function setupThemeToggle() {
				const toggle = document.getElementById("profile-menu-theme");
				const html = document.documentElement;

				toggle?.addEventListener("click", () => {
					const dark = !html.classList.contains("dark");
					// 전환 동안만 색 트랜지션을 켜서 부드럽게(끝나면 제거해 호버 등에 영향 없게)
					html.classList.add("theme-transition");
					window.setTimeout(() => html.classList.remove("theme-transition"), 320);
					html.classList.toggle("dark", dark);
					localStorage.setItem("theme", dark ? "dark" : "light");
				});
			}

			document.addEventListener("astro:page-load", setupThemeToggle);
		</script>

		<script>
			// 북마크·팔로우 버튼: 계정 없이 localStorage로 동작(lib/bookmarks·lib/follows).
			// ArticleCard·기사 상세·매체/카테고리 헤더 어디든 data-* 속성만 있으면 자동 바인딩된다.
			// LoadMore가 그려내는 카드는 새로 생기는 DOM이라 자체 스크립트에서 별도로 호출한다.
			import { setupBookmarkButtons } from "../lib/bookmarks";
			import { setupFollowButtons } from "../lib/follows";

			document.addEventListener("astro:page-load", () => {
				setupBookmarkButtons();
				setupFollowButtons();
			});
		</script>
	</body>
</html>
