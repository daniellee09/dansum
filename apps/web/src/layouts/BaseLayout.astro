---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
	/** 공유 카드 타입: 홈/목록은 website, 기사 상세는 article */
	type?: "website" | "article";
}

const {
	title = "단숨 - AI 경제 뉴스 요약",
	description = "세계 주요 경제 뉴스를 단숨에 파악하세요. AI가 핵심만 요약해드립니다.",
	type = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.url).href;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />

		<!-- Open Graph (카카오톡·페북 등 공유 미리보기) -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="단숨" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- Pretendard 폰트 -->
		<link
			rel="stylesheet"
			as="style"
			crossorigin
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- 페이지 전환 애니메이션(SPA식 부드러운 전환) -->
		<ClientRouter />

		<!-- 다크 모드 깜빡임 방지: 최초 렌더 전 + 페이지 전환(swap) 직후에 클래스 재적용 -->
		<script is:inline>
			function applyTheme() {
				const stored = localStorage.getItem("theme");
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle(
					"dark",
					stored === "dark" || (!stored && prefersDark),
				);
			}
			applyTheme();
			// View Transitions swap 시 들어오는 SSR 문서엔 .dark가 없어 깜빡일 수 있어 재적용
			document.addEventListener("astro:after-swap", applyTheme);
		</script>
	</head>
	<body class="min-h-screen flex flex-col">
		<div class="ambient" aria-hidden="true"></div>
		<Header />
		<main class="flex-1 w-full max-w-3xl mx-auto px-5 py-8">
			<slot />
		</main>
		<Footer />

		<!-- 맨 위로: 일정 스크롤 후 우하단에 부드럽게 등장 -->
		<button
			id="to-top"
			type="button"
			aria-label="맨 위로"
			class="fixed bottom-6 right-6 z-20 flex h-10 w-10 items-center justify-center rounded-full border border-border bg-surface/80 backdrop-blur text-text-secondary shadow-sm transition-all duration-200 hover:text-text hover:bg-surface-alt opacity-0 translate-y-2 pointer-events-none"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7" />
			</svg>
		</button>

		<script>
			// 맨 위로 버튼: window 스크롤 리스너는 1회만 등록(window는 전환 간 유지),
			// 버튼 참조/클릭 바인딩은 매 page-load마다 갱신(View Transitions로 버튼이 새로 그려짐)
			let toTopBtn: HTMLElement | null = null;
			const HIDDEN = ["opacity-0", "translate-y-2", "pointer-events-none"];
			function updateToTop() {
				if (!toTopBtn) return;
				const show = window.scrollY > 400;
				for (const c of HIDDEN) toTopBtn.classList.toggle(c, !show);
			}
			window.addEventListener("scroll", updateToTop, { passive: true });
			document.addEventListener("astro:page-load", () => {
				toTopBtn = document.getElementById("to-top");
				toTopBtn?.addEventListener("click", () => {
					const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
				});
				updateToTop();
			});
		</script>

		<script>
			// 페이지 전환(View Transitions) 후 헤더가 새로 그려지므로 매 page-load마다 재바인딩
			function setupThemeToggle() {
				const toggle = document.getElementById("theme-toggle");
				const html = document.documentElement;
				const iconMoon = document.getElementById("icon-moon");
				const iconSun = document.getElementById("icon-sun");

				function syncIcons(dark: boolean) {
					iconMoon?.classList.toggle("hidden", dark);
					iconSun?.classList.toggle("hidden", !dark);
				}

				// 초기: localStorage에 쓰지 않고 아이콘만 동기화
				// (저장하면 OS 다크모드 변경을 더 이상 따라가지 못함)
				syncIcons(html.classList.contains("dark"));

				toggle?.addEventListener("click", () => {
					const dark = !html.classList.contains("dark");
					// 전환 동안만 색 트랜지션을 켜서 부드럽게(끝나면 제거해 호버 등에 영향 없게)
					html.classList.add("theme-transition");
					window.setTimeout(() => html.classList.remove("theme-transition"), 320);
					html.classList.toggle("dark", dark);
					localStorage.setItem("theme", dark ? "dark" : "light");
					syncIcons(dark);
				});
			}

			document.addEventListener("astro:page-load", setupThemeToggle);
		</script>
	</body>
</html>
