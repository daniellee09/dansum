---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
	title?: string;
	description?: string;
	/** 공유 카드 타입: 홈/목록은 website, 기사 상세는 article */
	type?: "website" | "article";
	/** 본문 옆에 사이드바를 둘 만큼 넓은 칼럼이 필요한 페이지(기사 상세)용.
	    --content-w도 같이 늘려야 헤더 검색창과의 세로 중심선이 맞는다(global.css 참고). */
	wide?: boolean;
}

const {
	title = "단숨 - AI 경제 뉴스 요약",
	description = "세계 주요 경제 뉴스를 단숨에 파악하세요. AI가 핵심만 요약해드립니다.",
	type = "website",
	wide = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.url).href;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />

		<!-- Open Graph (카카오톡·페북 등 공유 미리보기) -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="단숨" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- Pretendard 폰트 -->
		<link
			rel="stylesheet"
			as="style"
			crossorigin
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- 페이지 전환 애니메이션(SPA식 부드러운 전환) -->
		<ClientRouter />

		<!-- 다크 모드·사이드바 깜빡임 방지: 최초 렌더 전 + 페이지 전환(swap) 직후에 클래스 재적용 -->
		<script is:inline>
			function applyTheme() {
				const stored = localStorage.getItem("theme");
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle(
					"dark",
					stored === "dark" || (!stored && prefersDark),
				);
			}
			// 데스크톱 사이드바는 기본 고정. 사용자가 접었을 때만 클래스를 붙인다.
			function applySidebar() {
				document.documentElement.classList.toggle(
					"sidebar-collapsed",
					localStorage.getItem("sidebar") === "collapsed",
				);
			}
			applyTheme();
			applySidebar();
			// View Transitions swap 시 들어오는 SSR 문서엔 상태 클래스가 없어 깜빡일 수 있어 재적용
			document.addEventListener("astro:after-swap", () => {
				applyTheme();
				applySidebar();
			});
		</script>
	</head>
	<body class="min-h-screen pt-[var(--header-h)]">
		<!-- 헤더는 전폭이라 app-shell(사이드바 폭만큼 밀림) 바깥에 둔다 -->
		<Header />
		<Sidebar />
		<!-- app-shell: 데스크톱에서 고정된 사이드바 폭만큼 밀린다(global.css) -->
		<div class:list={["app-shell flex flex-col transition-[padding] duration-200 ease-out", wide && "app-shell--wide"]}>
			<main
				class:list={[
					"flex-1 w-full mx-auto px-5 py-7 max-w-4xl",
					wide && "min-[87.5rem]:max-w-[86rem]",
				]}
			>
				<slot />
			</main>
			<Footer />
		</div>

		<!-- wide(기사 상세): 사이드바가 붙을 만큼 폭이 넉넉한 화면(wide-min)에서만 본문 칼럼을 넓힌다.
		     --content-w도 같이 늘려야 그 폭에서도 헤더 검색창과 세로 중심선이 계속 맞는다(global.css 참고). -->
		<style>
			@media (min-width: 87.5rem) {
				.app-shell--wide {
					--content-w: 86rem;
				}
			}
		</style>

		<!-- 맨 위로: 일정 스크롤 후 우하단에 부드럽게 등장 -->
		<button
			id="to-top"
			type="button"
			aria-label="맨 위로"
			class="fixed bottom-6 right-6 z-20 flex h-10 w-10 items-center justify-center rounded-md border border-border bg-surface text-text-secondary transition-all duration-200 hover:text-text hover:bg-surface-alt opacity-0 translate-y-2 pointer-events-none"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7" />
			</svg>
		</button>

		<script>
			// 맨 위로 버튼: window 스크롤 리스너는 1회만 등록(window는 전환 간 유지),
			// 버튼 참조/클릭 바인딩은 매 page-load마다 갱신(View Transitions로 버튼이 새로 그려짐)
			let toTopBtn: HTMLElement | null = null;
			const HIDDEN = ["opacity-0", "translate-y-2", "pointer-events-none"];
			function updateToTop() {
				if (!toTopBtn) return;
				const show = window.scrollY > 400;
				for (const c of HIDDEN) toTopBtn.classList.toggle(c, !show);
			}
			window.addEventListener("scroll", updateToTop, { passive: true });
			document.addEventListener("astro:page-load", () => {
				toTopBtn = document.getElementById("to-top");
				toTopBtn?.addEventListener("click", () => {
					const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
				});
				updateToTop();
			});
		</script>

		<script>
			// 페이지 전환(View Transitions) 후 헤더가 새로 그려지므로 매 page-load마다 재바인딩
			function setupThemeToggle() {
				const toggle = document.getElementById("theme-toggle");
				const html = document.documentElement;
				const iconMoon = document.getElementById("icon-moon");
				const iconSun = document.getElementById("icon-sun");

				function syncIcons(dark: boolean) {
					iconMoon?.classList.toggle("hidden", dark);
					iconSun?.classList.toggle("hidden", !dark);
				}

				// 초기: localStorage에 쓰지 않고 아이콘만 동기화
				// (저장하면 OS 다크모드 변경을 더 이상 따라가지 못함)
				syncIcons(html.classList.contains("dark"));

				toggle?.addEventListener("click", () => {
					const dark = !html.classList.contains("dark");
					// 전환 동안만 색 트랜지션을 켜서 부드럽게(끝나면 제거해 호버 등에 영향 없게)
					html.classList.add("theme-transition");
					window.setTimeout(() => html.classList.remove("theme-transition"), 320);
					html.classList.toggle("dark", dark);
					localStorage.setItem("theme", dark ? "dark" : "light");
					syncIcons(dark);
				});
			}

			document.addEventListener("astro:page-load", setupThemeToggle);
		</script>
	</body>
</html>
