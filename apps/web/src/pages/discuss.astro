---
import BaseLayout from "../layouts/BaseLayout.astro";
import SourceIcon from "../components/SourceIcon.astro";
import { formatRelativeTime } from "@dansum/shared";
import { listActiveDiscussions } from "../lib/server/comments";

const db = Astro.locals.runtime.env.DB;

// 논의는 계정 도메인이라 apps/api를 거치지 않고 D1에서 바로 읽는다
// (listNotifications가 이미 같은 방식으로 articles를 조인한다).
const discussions = await listActiveDiscussions(db, 30);

// 각 이슈의 대표 기사. issues.lead_article_id는 컬렉터가 재계산하는 캐시라 그걸 그대로 쓴다.
interface LeadRow {
	issue_id: string;
	article_id: string;
	title: string;
	source_id: string;
	source_name: string;
	source_url: string;
	source_count: number;
}
let leads: LeadRow[] = [];
if (discussions.length > 0) {
	const placeholders = discussions.map(() => "?").join(",");
	const { results } = await db
		.prepare(
			`SELECT i.id AS issue_id, a.id AS article_id, a.title, a.source_id, a.source_name,
			        a.source_url, i.source_count
			 FROM issues i JOIN articles a ON a.id = i.lead_article_id
			 WHERE i.id IN (${placeholders})`,
		)
		.bind(...discussions.map((d) => d.issueId))
		.all<LeadRow>();
	leads = results;
}
const leadByIssue = new Map(leads.map((l) => [l.issue_id, l]));

// 대표 기사를 못 찾은 이슈(집계가 한 tick 늦은 경우)는 조용히 뺀다 — 제목 없는 행은 쓸모가 없다.
const rows = discussions
	.map((d) => ({ ...d, lead: leadByIssue.get(d.issueId) }))
	.filter((r): r is typeof r & { lead: LeadRow } => r.lead !== undefined);
---

<BaseLayout title="토론 - 단숨" description="지금 논의가 오가고 있는 경제 이슈">
	<section>
		<h2 class="text-lg font-bold mb-1">토론</h2>
		<p class="text-[13px] text-text-secondary mb-4">
			최근 일주일 동안 의견이 오간 이슈입니다. 댓글 수보다 <strong class="font-semibold">참여한 사람 수</strong>를 먼저 봅니다.
		</p>

		{rows.length === 0 ? (
			<div class="py-16 text-center">
				<p class="text-sm text-text-secondary">아직 논의가 오간 이슈가 없어요.</p>
				<p class="mt-1 text-xs text-text-secondary">
					기사에 의견을 남기면 같은 사건을 다룬 다른 매체의 기사에도 함께 보입니다.
				</p>
			</div>
		) : (
			<ol class="divide-y divide-border border-t border-border">
				{rows.map((r) => (
					<li class="group -mx-4 px-4 py-4 transition-colors hover:bg-surface-alt">
						<a href={`/issue/${r.issueId}`} class="block">
							<div class="flex items-center gap-2 text-[13px] text-text-secondary">
								<SourceIcon
									sourceId={r.lead.source_id}
									sourceUrl={r.lead.source_url}
									sourceName={r.lead.source_name}
									size={18}
								/>
								<span>{r.lead.source_name}</span>
								{r.lead.source_count > 1 && (
									<span class="tabular-nums">외 {r.lead.source_count - 1}개 매체</span>
								)}
								<span class="tabular-nums">{formatRelativeTime(r.lastAt)}</span>
							</div>
							<h3 class="mt-1 font-semibold leading-snug text-text group-hover:text-brand transition-colors">
								{r.lead.title}
							</h3>
							{/* 참여자 수를 앞에 둔다 — 이 목록이 무엇으로 정렬됐는지가 한 줄로 읽혀야 한다 */}
							<p class="mt-1 text-[13px] text-text-secondary tabular-nums">
								{r.participants}명 참여 · 댓글 {r.comments}
							</p>
						</a>
					</li>
				))}
			</ol>
		)}
	</section>
</BaseLayout>
