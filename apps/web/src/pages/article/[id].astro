---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticle, getArticles, getRelatedArticles } from "../../lib/api";
import { renderEmphasis } from "../../lib/markdown";
import { CATEGORY_LABELS, formatKoreanDate, formatRelativeTime } from "@dansum/shared";
import type { Article, Category } from "@dansum/shared";
import SourceIcon from "../../components/SourceIcon.astro";
import TopicSuggestions from "../../components/TopicSuggestions.astro";
import { suggestTopics } from "../../lib/server/discussions";

const { id } = Astro.params;

if (!id) return Astro.redirect("/");

let article: Awaited<ReturnType<typeof getArticle>> | null = null;
let related: Article[] = [];
let sourceRecent: Article[] = [];
let sourceTotal: number | null = null;
let error: string | null = null;

try {
	article = await getArticle(id);
	// 사이드바 항목은 실패해도 본문 렌더는 유지
	related = await getRelatedArticles(id).catch(() => []);
	const sourceArticles = await getArticles({ source: article.sourceId, pageSize: 6 }).catch(
		() => null,
	);
	sourceRecent = (sourceArticles?.items ?? []).filter((a) => a.id !== article?.id).slice(0, 4);
	sourceTotal = sourceArticles?.total ?? null;
} catch (e) {
	error = e instanceof Error ? e.message : "Failed to load article";
}

if (!article && !error) return Astro.redirect("/");

// 여러 매체가 다룬 사건이라면 댓글창 옆에서 토론을 권한다 — 다 읽은 직후가 가장 쓰고 싶은
// 순간이다. 이 기사가 속한 이슈에 이미 토론이 열려 있으면 suggestTopics가 알아서 뺀다.
const topicSuggestions =
	article?.issueId
		? (await suggestTopics(Astro.locals.runtime.env.DB, 5)).filter(
				(t) => t.issueId === article?.issueId,
			)
		: [];
---

<BaseLayout
	type="article"
	wide
	title={article ? `${article.title} - 단숨` : "기사를 찾을 수 없습니다"}
	description={article?.summary}
>
	{error || !article ? (
		<div class="py-20 text-center">
			<p class="text-lg text-text-secondary">기사를 찾을 수 없습니다</p>
			<a href="/" class="text-brand text-sm mt-2 inline-block hover:underline">
				홈으로 돌아가기
			</a>
		</div>
	) : (
		<!-- 본문(최대 46rem) + 우측 매체 사이드바(20rem)를 하나의 덩어리로 보고, 그 덩어리 전체가
		     헤더 검색창과 같은 세로 중심선에 오도록 한다(본문만 따로 중앙에 두지 않는다 — 그러면
		     사이드바가 붙는 만큼 전체 덩어리는 검색창 기준 오른쪽으로 치우쳐 보인다).
		     BaseLayout의 --content-w/max-w를 이 두 칼럼 폭 합(46+20+2 gap+2.5 ml-10=70.5rem)에
		     맞춰뒀기 때문에, 본문+사이드바를 감싸는 <main>이 그 폭 그대로 검색창과 가운데 정렬된다.
		     ml-10은 왼쪽 사이드바 메뉴에 본문이 바짝 붙어 보이는 걸 피하기 위한 여유 간격(가운데 정렬은
		     아주 미세하게만 어긋나며, 큰 화면에서는 체감되지 않는다).
		     좁은 화면(min-[87.5rem] 미만)에서는 그리드를 끄고 본문 아래로 사이드바가 자연스럽게 쌓인다. -->
		<div class="min-[87.5rem]:grid min-[87.5rem]:grid-cols-[minmax(0,46rem)_20rem] min-[87.5rem]:gap-x-8 min-[87.5rem]:ml-10">
			<article class="min-w-0" data-article-id={article.id}>
				<!-- 메타 -->
				<div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-5 text-[15px]">
					<a href={`/source/${article.sourceId}`} tabindex="-1" aria-hidden="true" class="shrink-0">
						<SourceIcon
							sourceId={article.sourceId}
							sourceUrl={article.sourceUrl}
							sourceName={article.sourceName}
							size={30}
						/>
					</a>
					<a
						href={`/source/${article.sourceId}`}
						class="font-bold text-text hover:text-brand hover:underline"
					>
						{article.sourceName}
					</a>
					<span class="text-text-secondary">&middot;</span>
					<a
						href={`/category/${article.category}`}
						class="font-semibold text-accent hover:text-brand hover:underline"
					>
						{CATEGORY_LABELS[article.category as Category] ?? article.category}
					</a>
					<span class="text-text-secondary">&middot;</span>
					<span class="text-text-secondary">
						{formatKoreanDate(article.publishedAt)}
					</span>
					<span class="text-text-secondary">&middot;</span>
					<a
						href={article.sourceUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="font-semibold text-brand hover:underline"
					>
						원문 &nearr;
					</a>
				</div>

				<!-- 제목 -->
				<h1 class="text-3xl font-bold leading-tight tracking-tight mb-5">
					{article.title}
				</h1>

				{article.originalTitle && article.originalTitle !== article.title && (
					<p class="text-sm text-text-secondary mb-6 italic">
						원문: {article.originalTitle}
					</p>
				)}

				<!-- 대표 이미지: 제목 바로 아래. object-scale-down으로 원본보다 키우지 않고(목록과 같은 규칙),
				     프레임(높이 440px 고정)의 남는 좌우 칸은 같은 사진을 확대·블러한 배경으로 채운다(레터박스 방지).
				     원본에 이미지가 없는 기사는 이 블록이 통째로 빠진다. -->
				{article.imageUrl && (
					<figure class="relative mb-6 h-[440px] overflow-hidden rounded-md border border-border bg-surface-alt">
						<div
							class="absolute inset-0 scale-110 bg-cover bg-center blur-2xl brightness-75"
							style={{ backgroundImage: `url("${article.imageUrl}")` }}
							aria-hidden="true"
						>
						</div>
						<img
							src={article.imageUrl}
							alt={article.title}
							loading="eager"
							decoding="async"
							referrerpolicy="no-referrer"
							class="relative mx-auto block h-full max-w-full object-scale-down"
							onerror="this.closest('figure').remove()"
						/>
					</figure>
				)}

				<!-- 요약 -->
				<div class="rounded-md border border-border bg-surface-alt px-4 py-3 mb-6">
					<h2 class="text-sm font-bold text-text-secondary uppercase tracking-wider mb-3">
						요약
					</h2>
					<p class="text-lg leading-relaxed">
						{article.summary}
					</p>
				</div>

				<!-- 핵심 포인트(TL;DR): 이것만 읽어도 기사를 파악할 수 있는 블록이라 본문 정리보다 앞에 둔다 -->
				<div class="mb-8">
					<h2 class="text-sm font-bold text-text-secondary uppercase tracking-wider mb-3">
						핵심 포인트
					</h2>
					<ul class="space-y-3">
						{article.keyPoints.map((point) => (
							<li class="flex items-start gap-3">
								<span class="text-accent text-lg leading-none mt-0.5">&bull;</span>
								<span class="text-[17px] leading-relaxed" set:html={renderEmphasis(point)} />
							</li>
						))}
					</ul>
				</div>

				<!-- 주요 내용(구조화 정리: 소제목 + 최대 2단 불릿) -->
				{(article.sections ?? []).length > 0 && (
					<div class="mb-8">
						<h2 class="text-sm font-bold text-text-secondary uppercase tracking-wider mb-3">
							주요 내용
						</h2>
						<div class="space-y-6">
							{article.sections.map((s) => (
								<div>
									<h3 class="text-lg font-bold mb-2">{s.heading}</h3>
									<ul class="space-y-2">
										{s.points.map((p) => (
											<li>
												<div class="flex items-start gap-3">
													<span class="text-accent text-lg leading-none mt-0.5">&bull;</span>
													<span class="text-[17px] leading-relaxed" set:html={renderEmphasis(p.text)} />
												</div>
												{p.children && p.children.length > 0 && (
													<ul class="mt-1.5 ml-6 space-y-1.5">
														{p.children.map((c) => (
															<li class="flex items-start gap-2.5">
																<span class="text-text-secondary text-xs leading-none mt-1.5">&#9702;</span>
																<span
																	class="text-[15px] text-text-secondary leading-relaxed"
																	set:html={renderEmphasis(c)}
																/>
															</li>
														))}
													</ul>
												)}
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</div>
				)}

				<!-- 키워드 -->
				{/* 키워드 칩: 검색으로 가는 링크 + 알림 벨. 벨을 칩 안에 붙이는 이유는,
				     "이 키워드로 알림 받기"를 결정하는 순간이 바로 그 키워드를 보고 있는 지금이라서다.
				     별도 설정 화면까지 찾아가야 하면 아무도 등록하지 않는다. */}
				{article.keywords.length > 0 && (
					<div class="flex flex-wrap gap-2 mb-8">
						{article.keywords.map((kw) => (
							<span class="inline-flex items-center rounded bg-surface-alt text-[13px] text-text-secondary">
								<a
									href={`/search?q=${encodeURIComponent(kw)}`}
									class="rounded-l px-2.5 py-1 transition-colors hover:text-text"
								>
									#{kw}
								</a>
								<button
									type="button"
									data-keyword-alert
									data-keyword={kw}
									aria-pressed="false"
									aria-label={`${kw} 알림 받기`}
									title={`${kw} 알림 받기`}
									class="keyword-bell rounded-r py-1 pr-2 pl-0.5 text-text-secondary transition-colors hover:text-text"
								>
									<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
										<path stroke-linecap="round" stroke-linejoin="round" d="M18 8a6 6 0 10-12 0c0 6-2 7-2 7h16s-2-1-2-7M10.5 20a2 2 0 003 0" />
									</svg>
								</button>
							</span>
						))}
					</div>
				)}

				<!-- 하단 액션: 목록으로(좌) · 원문 보기(우) 한 줄 정렬 -->
				<div class="flex items-center justify-between pt-6 border-t border-border">
					<div class="flex items-center gap-4">
						<a
							id="back-to-list"
							href={`/category/${article.category}`}
							class="text-[15px] font-semibold text-text-secondary hover:text-text transition-colors"
						>
							&larr; 목록으로
						</a>
						<button
							type="button"
							data-bookmark-toggle
							data-article-id={article.id}
							aria-label="북마크"
							aria-pressed="false"
							class="bookmark-btn inline-flex items-center gap-1.5 text-[15px] font-semibold text-text-secondary hover:text-text transition-colors"
						>
							<svg data-bookmark-icon class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 4h12v16l-6-4-6 4V4z" />
							</svg>
							<span data-bookmark-label>북마크</span>
						</button>
					</div>
					<a
						href={article.sourceUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[15px] font-semibold text-brand hover:underline"
					>
						원문 보기 &rarr;
					</a>
				</div>

				<!-- 댓글: 계정 데이터라 클라이언트에서 그린다(lib/comments.ts). 단위는 이 기사다. -->
				<div class="mt-8 pt-6 border-t border-border" data-comments data-article-id={article.id}>
					<h2 class="text-lg font-bold mb-4">
						댓글 <span data-comment-count>0</span>
					</h2>
					<div data-comment-form-wrap class="mb-6"></div>
					<div data-comment-list></div>

					{topicSuggestions.length > 0 && (
						<div class="mt-8">
							<TopicSuggestions topics={topicSuggestions} compact />
						</div>
					)}
				</div>
			</article>

			<!-- 우측 사이드바: 매체 정보 · 이 매체의 다른 기사 · 관련 보도(타 매체).
			     본문이 훨씬 길어서 사이드바 내용을 다 보려면 끝까지 스크롤해야 하는 문제를 피하려고,
			     사이드바 자체 높이를 뷰포트로 제한하고 내부에서만 스크롤되게 한다(overflow-y-auto). -->
			<aside class="mt-8 space-y-4 min-[87.5rem]:mt-0 min-[87.5rem]:sticky min-[87.5rem]:top-[calc(var(--header-h)+1.5rem)] min-[87.5rem]:self-start min-[87.5rem]:max-h-[calc(100vh-var(--header-h)-3rem)] min-[87.5rem]:overflow-y-auto">
				<div class="rounded-2xl bg-surface-alt p-5">
					<div class="flex items-center gap-3">
						<a href={`/source/${article.sourceId}`} tabindex="-1" aria-hidden="true" class="shrink-0">
							<SourceIcon
								sourceId={article.sourceId}
								sourceUrl={article.sourceUrl}
								sourceName={article.sourceName}
								size={48}
							/>
						</a>
						<div class="min-w-0 flex-1">
							<a
								href={`/source/${article.sourceId}`}
								class="block text-lg font-bold text-text leading-tight hover:text-brand hover:underline"
							>
								{article.sourceName}
							</a>
							<a
								href={`/category/${article.category}`}
								class="text-[13px] font-semibold text-accent hover:text-brand hover:underline"
							>
								{CATEGORY_LABELS[article.category as Category] ?? article.category}
							</a>
						</div>
					</div>

					<button
						type="button"
						data-follow-toggle
						data-follow-type="source"
						data-follow-value={article.sourceId}
						aria-pressed="false"
						class="follow-btn mt-4 block w-full rounded-full bg-brand py-2 text-center text-[13px] font-bold text-white transition-colors hover:brightness-110 aria-pressed:border aria-pressed:border-border aria-pressed:bg-surface aria-pressed:text-text aria-pressed:hover:bg-surface-alt"
					>
						팔로우
					</button>

					{sourceTotal !== null && (
						<div class="mt-4 border-t border-border pt-4">
							<p class="text-xl font-bold text-text tabular-nums">{sourceTotal}건</p>
							<p class="text-[13px] text-text-secondary">이 매체가 낸 기사</p>
						</div>
					)}

					<a
						href={`/source/${article.sourceId}`}
						class="mt-4 block rounded-full bg-surface py-2 text-center text-[13px] font-semibold text-text transition-colors hover:bg-[color-mix(in_oklab,var(--color-text)_8%,var(--color-surface))]"
					>
						이 매체 전체 보기
					</a>
				</div>

				{sourceRecent.length > 0 && (
					<div class="rounded-2xl bg-surface-alt p-5">
						<h2 class="text-sm font-bold text-text-secondary uppercase tracking-wider mb-3">
							{article.sourceName}의 다른 기사
						</h2>
						<ul class="divide-y divide-border">
							{sourceRecent.map((a) => (
								<li class="group relative py-2.5 first:pt-0 last:pb-0">
									<a href={`/article/${a.id}`} class="read-link stretch-link block">
										<p class="text-[14px] font-semibold leading-snug group-hover:text-brand transition-colors line-clamp-2">
											{a.title}
										</p>
										<time class="mt-1 block text-[12px] text-text-secondary tabular-nums">
											{formatRelativeTime(a.publishedAt)}
										</time>
									</a>
								</li>
							))}
						</ul>
					</div>
				)}

				{related.length > 0 && (
					<div class="rounded-2xl bg-surface-alt p-5">
						<h2 class="text-sm font-bold text-text-secondary uppercase tracking-wider mb-3">
							관련 보도 {related.length}건
						</h2>
						<ul class="divide-y divide-border">
							{related.map((r) => (
								<li class="group relative py-2.5 first:pt-0 last:pb-0">
									<div class="flex items-center gap-x-1.5 mb-1 text-[12px] text-text-secondary">
										<a href={`/source/${r.sourceId}`} tabindex="-1" aria-hidden="true" class="stretch-over shrink-0">
											<SourceIcon
												sourceId={r.sourceId}
												sourceUrl={r.sourceUrl}
												sourceName={r.sourceName}
												size={18}
											/>
										</a>
										<a
											href={`/source/${r.sourceId}`}
											class="stretch-over font-bold text-text hover:text-brand hover:underline"
										>
											{r.sourceName}
										</a>
										<span aria-hidden="true">·</span>
										<time class="tabular-nums">{formatRelativeTime(r.publishedAt)}</time>
									</div>
									<a href={`/article/${r.id}`} class="read-link stretch-link block">
										<p class="text-[14px] font-semibold leading-snug group-hover:text-brand transition-colors line-clamp-2">
											{r.title}
										</p>
									</a>
								</li>
							))}
						</ul>
					</div>
				)}
			</aside>
		</div>
	)}
</BaseLayout>

<script>
	// 홈 화면 "최근 본 기사" 위젯이 읽을 수 있게 방문을 기록한다(lib/recentlyViewed.ts).
	// 계정이 없어 localStorage 기반이라 서버가 아닌 클라이언트에서 기록한다.
	import { addRecentlyViewed } from "../../lib/recentlyViewed";
	import { mountComments } from "../../lib/comments";

	document.addEventListener("astro:page-load", () => {
		const id = document.querySelector<HTMLElement>("[data-article-id]")?.dataset.articleId;
		if (id) addRecentlyViewed(id);

		const commentsRoot = document.querySelector<HTMLElement>("[data-comments]");
		const commentArticleId = commentsRoot?.dataset.articleId;
		if (commentsRoot && commentArticleId) mountComments(commentsRoot, { articleId: commentArticleId });
	});
</script>

<script>
	// "목록으로": 같은 사이트 안에서 들어왔으면 이전 목록(홈/주요뉴스·카테고리)으로
	// 되돌아간다(스크롤 위치 보존). 직접 접속 등 기록이 없으면 href 폴백.
	// View Transitions로 본문이 교체되므로 매 page-load마다 재바인딩한다.
	function setupBackToList() {
		const back = document.getElementById("back-to-list");
		if (!back) return;
		const ref = document.referrer;
		const sameOrigin = ref && new URL(ref).origin === location.origin;
		const cameFromArticle = sameOrigin && new URL(ref).pathname.startsWith("/article/");
		if (sameOrigin && !cameFromArticle) {
			back.addEventListener("click", (e) => {
				e.preventDefault();
				history.back();
			});
		}
	}

	document.addEventListener("astro:page-load", setupBackToList);
</script>
