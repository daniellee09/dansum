---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatRelativeTime } from "@dansum/shared";
import { listNotifications } from "../lib/server/comments";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?redirect=/notifications");

// 헤더 드롭다운(20건)으로는 부족해서 만든 화면이라 넉넉히 가져온다. 페이지네이션은 두지 않는다 —
// 알림은 쌓아두고 읽는 게 아니라 놓친 것을 확인하는 화면이다.
const notifications = await listNotifications(Astro.locals.runtime.env.DB, user.id, 100);

function href(n: (typeof notifications)[number]): string {
	// lib/notifications.ts의 notificationLink와 같은 규칙(종류별 목적지)
	if (n.type === "keyword" && n.payload.issueId) return `/issue/${n.payload.issueId}`;
	const base = n.payload.discussionId
		? `/discuss/${n.payload.discussionId}`
		: `/article/${n.payload.articleId}`;
	return n.payload.commentId ? `${base}#comment-${n.payload.commentId}` : base;
}
---

<BaseLayout title="알림 - 단숨" description="답글과 키워드 알림">
	<section>
		<div class="mb-4 flex items-baseline justify-between gap-3">
			<h2 class="text-lg font-bold">알림</h2>
			<button
				id="mark-all"
				type="button"
				class="text-[13px] text-text-secondary hover:text-brand transition-colors"
			>
				모두 읽음
			</button>
		</div>

		{notifications.length === 0 ? (
			<div class="py-16 text-center">
				<p class="text-sm text-text-secondary">아직 알림이 없습니다.</p>
				<p class="mt-1 text-xs text-text-secondary">
					답글이 달리거나, 회원님이 연 토론에 댓글이 달리면 여기로 알려드려요.
				</p>
			</div>
		) : (
			<ul class="divide-y divide-border border-t border-border">
				{notifications.map((n) => (
					<li>
						<a
							href={href(n)}
							data-notif-id={n.id}
							class:list={[
								"-mx-4 block px-4 py-3.5 transition-colors hover:bg-surface-alt",
								!n.isRead && "bg-brand/5",
							]}
						>
							<p class="text-sm text-text">
								{n.type === "keyword" ? (
									<><span class="font-semibold">{n.payload.keyword}</span> 관련 새 이슈가 올라왔습니다</>
								) : n.type === "discussion_comment" ? (
									<><span class="font-semibold">{n.payload.fromNickname}</span>님이 회원님의 토론에 댓글을 남겼습니다</>
								) : (
									<><span class="font-semibold">{n.payload.fromNickname}</span>님이 댓글에 답글을 남겼습니다</>
								)}
							</p>
							<p class="mt-0.5 truncate text-[13px] text-text-secondary">
								{n.payload.articleTitle ?? "삭제된 기사"}
							</p>
							<p class="mt-0.5 text-xs text-text-secondary">{formatRelativeTime(n.createdAt)}</p>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>
</BaseLayout>

<script>
	document.addEventListener("astro:page-load", () => {
		// 클릭한 알림만 읽음 처리(헤더 드롭다운과 같은 규칙). 이동을 막지 않으려고 응답을 기다리지 않는다.
		for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-notif-id]")) {
			a.addEventListener("click", () => {
				fetch(`/api/me/notifications/${a.dataset.notifId}/read`, { method: "POST" }).catch(() => {});
			});
		}

		document.getElementById("mark-all")?.addEventListener("click", async () => {
			await fetch("/api/me/notifications/read-all", { method: "POST" }).catch(() => {});
			location.reload();
		});
	});
</script>
