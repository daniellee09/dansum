---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="회원가입 - 단숨" description="단숨 계정을 만들고 북마크·팔로우를 저장하세요">
	<section class="max-w-sm mx-auto py-10">
		<h2 class="text-xl font-bold mb-6 text-center">회원가입</h2>

		<form id="register-form" class="flex flex-col gap-4" novalidate>
			<div class="flex flex-col gap-1.5">
				<label for="nickname" class="text-sm text-text-secondary">닉네임</label>
				<input
					id="nickname"
					name="nickname"
					type="text"
					minlength="2"
					maxlength="20"
					autocomplete="nickname"
					required
					class="w-full rounded-md border border-border bg-surface-alt px-3.5 py-2.5 text-[15px] outline-none transition-colors focus:border-brand focus:bg-surface focus:ring-2 focus:ring-brand/40"
				/>
			</div>
			<div class="flex flex-col gap-1.5">
				<label for="email" class="text-sm text-text-secondary">이메일</label>
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					required
					class="w-full rounded-md border border-border bg-surface-alt px-3.5 py-2.5 text-[15px] outline-none transition-colors focus:border-brand focus:bg-surface focus:ring-2 focus:ring-brand/40"
				/>
			</div>
			<div class="flex flex-col gap-1.5">
				<label for="password" class="text-sm text-text-secondary">비밀번호</label>
				<input
					id="password"
					name="password"
					type="password"
					minlength="8"
					autocomplete="new-password"
					required
					class="w-full rounded-md border border-border bg-surface-alt px-3.5 py-2.5 text-[15px] outline-none transition-colors focus:border-brand focus:bg-surface focus:ring-2 focus:ring-brand/40"
				/>
				<p class="text-xs text-text-secondary">8자 이상</p>
			</div>

			<p id="register-error" class="hidden text-sm text-hot"></p>

			<button
				type="submit"
				id="register-submit"
				class="mt-2 rounded-full bg-brand py-2.5 text-center text-[15px] font-semibold text-white transition-colors hover:brightness-110 disabled:opacity-50 disabled:cursor-not-allowed"
			>
				회원가입
			</button>
		</form>

		<p class="mt-5 text-center text-sm text-text-secondary">
			이미 계정이 있으신가요?
			<a href="/login" class="text-brand hover:underline">로그인</a>
		</p>
	</section>
</BaseLayout>

<script>
	import { migrateLocalDataToAccount } from "../lib/migrateLocal";

	function setupRegisterForm() {
		const form = document.getElementById("register-form") as HTMLFormElement | null;
		const errorEl = document.getElementById("register-error");
		const submitBtn = document.getElementById("register-submit") as HTMLButtonElement | null;
		if (!form || form.dataset.bound) return;
		form.dataset.bound = "true";

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			errorEl?.classList.add("hidden");
			if (submitBtn) submitBtn.disabled = true;

			const formData = new FormData(form);
			try {
				const res = await fetch("/api/auth/register", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						nickname: formData.get("nickname"),
						email: formData.get("email"),
						password: formData.get("password"),
					}),
				});
				const data = (await res.json()) as { success: boolean; error?: string };
				if (!res.ok || !data.success) {
					if (errorEl) {
						errorEl.textContent = data.error ?? "회원가입에 실패했습니다";
						errorEl.classList.remove("hidden");
					}
					return;
				}
				await migrateLocalDataToAccount();
				const redirect = new URLSearchParams(location.search).get("redirect") || "/";
				window.location.href = redirect;
			} catch {
				if (errorEl) {
					errorEl.textContent = "네트워크 오류가 발생했습니다";
					errorEl.classList.remove("hidden");
				}
			} finally {
				if (submitBtn) submitBtn.disabled = false;
			}
		});
	}

	document.addEventListener("astro:page-load", setupRegisterForm);
</script>
