---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import LoadMore from "../../components/LoadMore.astro";
import SortTabs from "../../components/SortTabs.astro";
import SourceIcon from "../../components/SourceIcon.astro";
import { getArticles } from "../../lib/api";

const { id } = Astro.params;

if (!id) return Astro.redirect("/");

const sort = Astro.url.searchParams.get("sort") === "hot" ? "hot" : "latest";

let articles: Awaited<ReturnType<typeof getArticles>> | null = null;
let error: string | null = null;

try {
	articles = await getArticles({ source: id, sort });
} catch (e) {
	error = e instanceof Error ? e.message : "Failed to load articles";
}

// 매체 표시 정보는 별도 API 없이 첫 기사에서 가져온다(결과가 없으면 id를 그대로 보여준다)
const lead = articles?.items[0];
const sourceName = lead?.sourceName ?? id;
---

<BaseLayout
	title={`${sourceName} - 단숨`}
	description={`${sourceName}의 최신 경제 뉴스 AI 요약`}
>
	<section>
		<div class="mb-3 flex items-center justify-between gap-2.5">
			<div class="flex items-center gap-2.5 min-w-0">
				{lead && (
					<SourceIcon
						sourceId={lead.sourceId}
						sourceUrl={lead.sourceUrl}
						sourceName={lead.sourceName}
						size={28}
					/>
				)}
				<div class="min-w-0">
					<h2 class="text-lg font-bold tracking-tight leading-tight">{sourceName}</h2>
					{articles && (
						<p class="text-[13px] text-text-secondary tabular-nums">
							기사 {articles.total}건
						</p>
					)}
				</div>
			</div>
			<button
				type="button"
				data-follow-toggle
				data-follow-type="source"
				data-follow-value={id}
				aria-pressed="false"
				class="follow-btn shrink-0 rounded-full border border-border px-3.5 py-1.5 text-[13px] font-semibold text-text-secondary transition-colors hover:border-text-secondary hover:text-text aria-pressed:border-brand aria-pressed:text-brand"
			>
				팔로우
			</button>
		</div>

		{error ? (
			<div class="py-12 text-center">
				<p class="text-text-secondary">{error}</p>
			</div>
		) : articles ? (
			<>
				<SortTabs basePath={`/source/${id}`} sort={sort} />
				<ArticleList articles={articles.items} />
				<LoadMore hasMore={articles.hasMore} source={id} sort={sort} />
			</>
		) : null}
	</section>
</BaseLayout>
