---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import { getHotArticles } from "../lib/api";

let articles: Awaited<ReturnType<typeof getHotArticles>> | null = null;
let error: string | null = null;

try {
	articles = await getHotArticles(50);
} catch (e) {
	error = e instanceof Error ? e.message : "Hot 기사를 불러오지 못했습니다";
}
---

<BaseLayout title="Hot - 단숨" description="최근 24시간 동안 여러 매체가 다룬 기사 50개">
	<section>
		<h2 class="flex items-center gap-1.5 text-lg font-bold mb-1">
			<!-- Sidebar.astro의 Hot 아이콘과 모양을 맞춰야 하니 수정 시 함께 동기화할 것 -->
			<svg class="h-5 w-5 shrink-0 fill-text-secondary" viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M12.5 1.5c1 3.2-1.8 5-3 7.5-.7-.9-1-2.2-1-3.3-2 2-3.5 5-3.5 8 0 4.6 3.5 8.3 8 8.3s8-3.7 8-8.3c0-3-1.6-5.6-3.7-7.4.1 1.3-.2 2.6-1 3.6-.4-3.3-2.3-5.6-3.8-8.4zm-.5 11c1 1.7 2.5 2.7 2.5 4.8 0 1.8-1.3 3.2-3 3.2s-3-1.4-3-3.2c0-1.1.4-1.9 1-2.7.4.5 1 .9 1 .9-.2-1.2.4-2 1.5-3z"
				/>
			</svg>
			Hot
		</h2>
		<p class="text-[13px] text-text-secondary mb-3">
			최근 24시간 동안 여러 매체가 다룬 기사 50개
		</p>

		{error ? (
			<div class="py-12 text-center">
				<p class="text-text-secondary">{error}</p>
			</div>
		) : (
			<ArticleList articles={articles ?? []} />
		)}
	</section>
</BaseLayout>
