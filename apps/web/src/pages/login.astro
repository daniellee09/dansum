---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="로그인 - 단숨" description="단숨에 로그인하고 북마크·팔로우를 계정에 저장하세요">
	<section class="max-w-sm mx-auto py-10">
		<h2 class="text-xl font-bold mb-6 text-center">로그인</h2>

		<form id="login-form" class="flex flex-col gap-4" novalidate>
			<div class="flex flex-col gap-1.5">
				<label for="email" class="text-sm text-text-secondary">이메일</label>
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					required
					class="w-full rounded-md border border-border bg-surface-alt px-3.5 py-2.5 text-[15px] outline-none transition-colors focus:border-brand focus:bg-surface focus:ring-2 focus:ring-brand/40"
				/>
			</div>
			<div class="flex flex-col gap-1.5">
				<label for="password" class="text-sm text-text-secondary">비밀번호</label>
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					required
					class="w-full rounded-md border border-border bg-surface-alt px-3.5 py-2.5 text-[15px] outline-none transition-colors focus:border-brand focus:bg-surface focus:ring-2 focus:ring-brand/40"
				/>
			</div>

			<p id="login-error" class="hidden text-sm text-hot"></p>

			<button
				type="submit"
				id="login-submit"
				class="mt-2 rounded-full bg-brand py-2.5 text-center text-[15px] font-semibold text-white transition-colors hover:brightness-110 disabled:opacity-50 disabled:cursor-not-allowed"
			>
				로그인
			</button>
		</form>

		<p class="mt-5 text-center text-sm text-text-secondary">
			아직 계정이 없으신가요?
			<a href="/register" class="text-brand hover:underline">회원가입</a>
		</p>
	</section>
</BaseLayout>

<script>
	import { migrateLocalDataToAccount } from "../lib/migrateLocal";

	function setupLoginForm() {
		const form = document.getElementById("login-form") as HTMLFormElement | null;
		const errorEl = document.getElementById("login-error");
		const submitBtn = document.getElementById("login-submit") as HTMLButtonElement | null;
		if (!form || form.dataset.bound) return;
		form.dataset.bound = "true";

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			errorEl?.classList.add("hidden");
			if (submitBtn) submitBtn.disabled = true;

			const formData = new FormData(form);
			try {
				const res = await fetch("/api/auth/login", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						email: formData.get("email"),
						password: formData.get("password"),
					}),
				});
				const data = (await res.json()) as { success: boolean; error?: string };
				if (!res.ok || !data.success) {
					if (errorEl) {
						errorEl.textContent = data.error ?? "로그인에 실패했습니다";
						errorEl.classList.remove("hidden");
					}
					return;
				}
				await migrateLocalDataToAccount();
				const redirect = new URLSearchParams(location.search).get("redirect") || "/";
				window.location.href = redirect;
			} catch {
				if (errorEl) {
					errorEl.textContent = "네트워크 오류가 발생했습니다";
					errorEl.classList.remove("hidden");
				}
			} finally {
				if (submitBtn) submitBtn.disabled = false;
			}
		});
	}

	document.addEventListener("astro:page-load", setupLoginForm);
</script>
